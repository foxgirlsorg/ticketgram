msgid "{header}✅ <b>marked this ticket as resolved</b>"
msgstr "{header}✅ <b>пометил(а) обращение как решеное</b>"

msgid "ℹ️ Usage: {} <pseudonym>"
msgstr "ℹ️ Подсказка: {} <псевдоним>"

msgid "ℹ️ Usage: {} <ticket_id OR username OR user_id>"
msgstr ""
"ℹ️ Подсказка: {} <id_обращения ИЛИ юзернейм ИЛИ id_пользователя>"

msgid "ℹ️ Usage: {} <ticket_id OR username OR user_id> <reason>"
msgstr ""
"ℹ️ Подсказка: {} <id_обращения ИЛИ юзернейм ИЛИ id_пользователя> "
"<причина>"

msgid ""
"ℹ️ Your ticket {tag} has been closed. Write again if you need "
"anything else — that will open a new one."
msgstr ""
"ℹ️ Ваше обращение {tag} закрыто. Напишите снова, если нужна помощь —"
" откроется новое обращение."

msgid "⚠️ Target must be a valid ticket id OR @username OR user id"
msgstr ""
"⚠️ Цель должна быть правильным идентификатором обращения ИЛИ "
"@юзернеймом ИЛИ идентификатором пользователя"

msgid ""
"⚠️ This ticket is closed — the reader will not see the reply."
msgstr "⚠️ Обращение закрыто — пользователь не увидит этот ответ."

msgid "⚠️ Ticket with this id doesn't exist in the database"
msgstr ""
"⚠️ Обращение с указанным идентификатором не существует в базе данных"

msgid ""
