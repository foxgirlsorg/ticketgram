TELEGRAM_TOKEN=TOP_SECRET_1337
AUTHORIZED_GROUP_ID=-1

BOT_LANGUAGE=ru
# Relative paths land in ticketgram/data/ — leave it alone unless you have a
# reason to move the database somewhere else.
DB_URI=tickets.db
# Working window. Not shown to readers — it only decides whether a ticket
# opened right now gets the "we'll answer once we're back" notice.
BOT_TIME_ACTIVE=10:00-20:00
BOT_TIME_ZONE=+3
BOT_ACTIVE_DAYS=monday tuesday wednesday thursday friday saturday sunday
